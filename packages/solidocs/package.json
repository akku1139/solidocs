{
  "name": "solidocs",
  "version": "0.1.0",
  "type": "module",
  "description": "",
  "scripts": {
    "check": "echo done",
    "check:shared": "cd src/shared && tsc --noEmit",
    "check:client": "cd src/client && tsc --noEmit",
    "check:node": "cd src/node && tsc --noEmit",
    "build": "tsc src/node/cli.ts src/node/index.ts --outDir dist --module nodenext --moduleResolution nodenext --target esnext --allowImportingTsExtensions false --rewriteRelativeImportExtensions --erasableSyntaxOnly --skipLibCheck --noEmit false",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "solidjs",
    "rolldown",
    "solidocs"
  ],
  "author": "akku",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akku1139/solidocs.git"
  },
  "homepage": "https://github.com/akku1139/solidocs#readme",
  "bugs": {
    "url": "https://github.com/akku1139/solidocs/issues"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "bin": "./bin/solidocs.mjs",
  "exports": {
    ".": {
      "types": "./src/shared/types.ts",
      "default": "./dist/node/index.js"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.4.3",
    "@solidjs/router": "^1.0.0",
    "github-slugger": "^2.0.0",
    "hono": "^4.13.3",
    "rolldown": "1.2.5",
    "solid-js": "^1.9.15",
    "valibot": "^1.4.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "devDependencies": {
    "@solidocs-dev/tsconfig": "workspace:*",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "main": "dist/node/index.js",
  "types": "src/shared/types.ts"
}

{
  "name": "create-solidocs",
  "version": "0.2.2",
  "description": "Scaffold a Solidocs site",
  "type": "module",
  "keywords": [
    "solidjs",
    "rolldown",
    "solidocs",
    "static-site-generator"
  ],
  "author": "akku",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akku1139/solidocs.git"
  },
  "homepage": "https://github.com/akku1139/solidocs#readme",
  "bugs": {
    "url": "https://github.com/akku1139/solidocs/issues"
  },
  "bin": "./dist/cli.mjs",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.mjs '--banner:js=#!/usr/bin/env node' '--footer:js=create(process.argv.slice(2));'",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
